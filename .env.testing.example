APP_NAME="Service Commerce Backend"
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=service_commerce_test
DB_USERNAME=root
DB_PASSWORD=

SUPER_ADMIN_NAME="Test Super Admin"
SUPER_ADMIN_EMAIL=admin@example.test
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_ADDITIONAL_USERS=

ADMIN_FRONTEND_ORIGIN=https://admin.example.test
ADMIN_STATEFUL_DOMAINS=admin.example.test
ADMIN_BROWSER_API_BASE=/api/v1

AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_MINUTES=43200
AUTH_PASSWORD_RESET_CODE_TTL_MINUTES=10
AUTH_PASSWORD_RESET_TOKEN_TTL_MINUTES=10
AUTH_PASSWORD_RESET_MAX_ATTEMPTS=5
AUTH_PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_resets
AUTH_REFRESH_COOKIE_NAME=admin_refresh_token
AUTH_CSRF_COOKIE_NAME=admin_csrf_token
ADMIN_REFRESH_COOKIE_PATH=/api/v1/admin/auth
ADMIN_CSRF_COOKIE_PATH=/
ADMIN_AUTH_COOKIE_SECURE=false
ADMIN_AUTH_COOKIE_SAME_SITE=strict
SANCTUM_EXPIRATION=15

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=array

MAIL_MAILER=array
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"
