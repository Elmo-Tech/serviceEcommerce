{
  "info": {
    "name": "Service Commerce - Identity and Authentication",
    "description": "Service Commerce admin API collection for Feature 001 Identity and Authentication plus Feature 002 Customers and Addresses. Requests go directly to the Laravel Backend API at {{baseUrl}}. Example request bodies use fake values that mirror the backend contract. Login and refresh keep accessToken and refreshToken available as Postman variables for follow-up admin requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.backend-example.net/api/v1" },
    { "key": "accessToken", "value": "fake-admin-access-token" },
    { "key": "refreshToken", "value": "fake-admin-refresh-token" }
  ],
  "item": [
    {
      "name": "Admin Auth",
      "item": [
        {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json().data;",
              "pm.environment.set('accessToken', data.accessToken);",
              "pm.environment.set('refreshToken', data.refreshToken);",
              "pm.test('Login returns both tokens in JSON', function () {",
              "  pm.expect(data.accessToken).to.be.a('string');",
              "  pm.expect(data.refreshToken).to.be.a('string');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.test\",\n  \"password\": \"AdminPassword1!\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/admin/auth/login"
      }
    },
    {
      "name": "Refresh",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json().data;",
              "pm.environment.set('accessToken', data.accessToken);",
              "pm.environment.set('refreshToken', data.refreshToken);",
              "pm.test('Refresh returns rotated tokens in JSON', function () {",
              "  pm.expect(data.accessToken).to.be.a('string');",
              "  pm.expect(data.refreshToken).to.be.a('string');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/admin/auth/refresh"
      }
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/admin/auth/logout"
      }
    },
    {
      "name": "Show Profile",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/admin/auth/profile"
      }
    },
    {
      "name": "Update Profile",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "_method",
              "value": "PATCH",
              "type": "text"
            },
            {
              "key": "name",
              "value": "Updated Admin",
              "type": "text"
            },
            {
              "key": "avatar",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": "{{baseUrl}}/admin/auth/profile"
      }
    },
    {
      "name": "Change Password",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"AdminPassword1!\",\n  \"password\": \"NewAdminPassword1!\",\n  \"passwordConfirmation\": \"NewAdminPassword1!\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/admin/auth/change-password"
      }
    },
    {
      "name": "Forgot Password",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.test\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/admin/auth/forgot-password"
      }
    },
    {
      "name": "Verify Forgot Password Code",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.test\",\n  \"code\": \"123456\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/admin/auth/verify-forgot-password-code"
      }
    },
    {
      "name": "Reset Password",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.test\",\n  \"resetToken\": \"ResetTokenExample1234567890\",\n  \"password\": \"NewAdminPassword1!\",\n  \"passwordConfirmation\": \"NewAdminPassword1!\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/admin/auth/reset-password"
      }
        }
      ]
    },
    {
      "name": "Admin Customers",
      "item": [
        {
          "name": "List Customers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/admin/customers?filter[status]=all&filter[hasAddresses]=true&sort=name&page=1&perPage=20"
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Customer Example\",\n  \"email\": \"customer@example.test\",\n  \"phone\": \"01001234567\",\n  \"phoneCountryCode\": \"EG\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/admin/customers"
          }
        },
        {
          "name": "Show Customer",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/admin/customers/1"
          }
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Customer Example\",\n  \"email\": \"updated.customer@example.test\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/admin/customers/1"
          }
        },
        {
          "name": "Delete Customer",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/admin/customers/1"
          }
        },
        {
          "name": "Restore Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/admin/customers/1/restore"
          }
        },
        {
          "name": "List Customer Addresses",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/admin/customers/1/addresses?filter[status]=all"
          }
        },
        {
          "name": "Create Customer Address",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Home\",\n  \"phone\": \"01001234567\",\n  \"phoneCountryCode\": \"EG\",\n  \"countryCode\": \"EG\",\n  \"city\": \"Cairo\",\n  \"area\": \"Maadi\",\n  \"street\": \"Street 9\",\n  \"notes\": \"Near the club\",\n  \"isDefault\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/admin/customers/1/addresses"
          }
        },
        {
          "name": "Show Customer Address",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/admin/customers/1/addresses/1"
          }
        },
        {
          "name": "Update Customer Address",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Work\",\n  \"city\": \"Giza\",\n  \"street\": \"Street 10\",\n  \"isDefault\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/admin/customers/1/addresses/1"
          }
        },
        {
          "name": "Delete Customer Address",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/admin/customers/1/addresses/1"
          }
        },
        {
          "name": "Restore Customer Address",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/admin/customers/1/addresses/1/restore"
          }
        },
        {
          "name": "Set Default Customer Address",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/admin/customers/1/addresses/1/default"
          }
        }
      ]
    }
  ]
}
