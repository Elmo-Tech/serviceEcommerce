<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_DEBUG" value="false"/>
        <env name="APP_LOCALE" value="ar"/>
        <env name="APP_FALLBACK_LOCALE" value="en"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="service_commerce_test"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>
        <env name="FILESYSTEM_DISK" value="public"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="SUPER_ADMIN_NAME" value="Test Super Admin"/>
        <env name="SUPER_ADMIN_EMAIL" value="admin@example.test"/>
        <env name="SUPER_ADMIN_PASSWORD" value="TestPassword1!"/>
        <env name="ADMIN_FRONTEND_ORIGIN" value="https://admin.example.test"/>
        <env name="ADMIN_STATEFUL_DOMAINS" value="admin.example.test"/>
        <env name="ADMIN_BROWSER_API_BASE" value="/api/v1"/>
        <env name="ADMIN_REFRESH_COOKIE_PATH" value="/api/v1/admin/auth"/>
        <env name="ADMIN_CSRF_COOKIE_PATH" value="/"/>
        <env name="ADMIN_AUTH_COOKIE_SECURE" value="false"/>
        <env name="ADMIN_AUTH_COOKIE_SAME_SITE" value="strict"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
