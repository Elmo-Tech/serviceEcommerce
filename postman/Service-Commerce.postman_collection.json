          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.test\",\n  \"code\": \"123456\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/admin/auth/verify-forgot-password-code"
      }
    },
    {
      "name": "Reset Password",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.test\",\n  \"resetToken\": \"ResetTokenExample1234567890\",\n  \"password\": \"NewAdminPassword1!\",\n  \"passwordConfirmation\": \"NewAdminPassword1!\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/admin/auth/reset-password"
      }
        }
      ]
    },
    {
      "name": "Admin Customers",
      "description": "Customer and customer-address endpoints. Egyptian phone numbers in API responses are returned as local national digits like 01001234567 without country code or spaces.",
      "item": [
        {
          "name": "List Customers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/admin/customers?filter[status]=all&filter[hasAddresses]=true&sort=name&page=1&perPage=20"
          }
        },
        {
          "name": "Create Customer",
          "description": "Creates an admin-managed customer. Egyptian phone numbers in the response return as local digits like 01001234567.",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Customer Example\",\n  \"email\": \"customer@example.test\",\n  \"phone\": \"01001234567\",\n  \"phoneCountryCode\": \"EG\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/admin/customers"
          }
        },
        {
          "name": "Show Customer",
          "description": "Returns the customer resource. Egyptian phone numbers are returned as local digits like 01001234567.",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/admin/customers/1"
          }
        },
