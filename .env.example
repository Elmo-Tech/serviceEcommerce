APP_NAME="Service Commerce Backend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.example-backend.net

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=service_commerce
DB_USERNAME=root
DB_PASSWORD=

SUPER_ADMIN_NAME="Service Commerce Super Admin"
SUPER_ADMIN_EMAIL=admin@example.test
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_ADDITIONAL_USERS=

ADMIN_FRONTEND_ORIGINS=https://admin.example-frontend.com,https://admin.example-frontend-staging.com

AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_MINUTES=43200
AUTH_PASSWORD_RESET_CODE_TTL_MINUTES=10
AUTH_PASSWORD_RESET_TOKEN_TTL_MINUTES=10
AUTH_PASSWORD_RESET_MAX_ATTEMPTS=5
AUTH_PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_resets
SANCTUM_EXPIRATION=15

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"
